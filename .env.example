# Senku — Environment Configuration Template
# Copy this file to .env and fill in your values.

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite database path (relative to project root)
DATABASE_URL="file:./db/custom.db"

# ─── Authentication (NextAuth) ────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Your deployment URL (use http://localhost:3000 for local dev)
NEXTAUTH_URL="http://localhost:3000"

# ─── API Bridge (optional) ────────────────────────────────────────────────────
# Auth token for the OpenAI-compatible bridge (/v1/chat/completions, /v1/messages)
# Leave empty to disable bridge authentication
HERMES_BRIDGE_TOKEN=""

# ─── User Identity ────────────────────────────────────────────────────────────
USER_NAME="Senku"
USER_EMAIL="operator@senku.local"

# ─── Upstream Provider Keys (optional seed/override) ─────────────────────────
# Initial API key for APInex provider (optional; keys can also be managed via the UI)
APINEX_API_KEY=""

# Senku — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# SQLite Database URL (defaults to db/custom.db relative to project root)
DATABASE_URL="file:./db/custom.db"

# Optional: Authentication token for external API bridges (/v1/chat/completions and /v1/messages)
HERMES_BRIDGE_TOKEN=""

# User Profile Identity
USER_NAME="Senku"
USER_EMAIL="operator@senku.local"

// Hermes — Personal AI Gateway
// Prisma schema (SQLite): providers, pooled keys, chats, messages,
// usage events (3-tier pacing limiter source of truth) and response cache.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Providers — exactly ONE is active at any time.
//   OxionAI : token-limited (500k tokens/key/month, 3-tier pacing)
//   APInex  : unlimited tier (hasTokenLimit = false, multiplier 4.0)
// ─────────────────────────────────────────────────────────────
model Provider {
  id              String  @id @default(cuid())
  name            String  @unique // "OxionAI" | "APInex"
  slug            String  @unique // "oxionai" | "apinex"
  baseUrl         String? // OpenAI-compatible base URL (e.g. https://api.apinex.bond/v1)
  hasTokenLimit   Boolean @default(true)
  tokenLimitPerKey Int    @default(500000) // monthly pool per key (OxionAI)
  tokenMultiplier Float   @default(1.0) // usage accounting multiplier (APInex = 4.0)
  isActive        Boolean @default(false)
  models          String  @default("[]") // JSON array of model ids
  // Run 35 — THE ORRERY: persistent round-robin cursor. Index into
  // the provider's ACTIVE keys (createdAt asc, the canonical ring
  // order) pointing at the seat that serves NEXT. Advances by
  // exactly one seat per successfully served request, survives
  // restarts (SQLite), and resets to 0 when the provider is switched.
  rotationCursor  Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  keys        ApiKey[]
  usageEvents UsageEvent[]
}

// ─────────────────────────────────────────────────────────────
// Pooled API keys — round-robin rotation runs over the ACTIVE
// provider's keys only.
// ─────────────────────────────────────────────────────────────
model ApiKey {
  id                  String    @id @default(cuid())
  providerId          String
  provider            Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  label               String // "Pool key #1", "Test key", ...
  keyValue            String // secret; never returned unmasked
  isActive            Boolean   @default(true)
  tokensUsedThisMonth Int       @default(0) // rolling monthly accumulator
  monthKey            String    @default("") // "YYYY-MM"; reset when month flips
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())

  usageEvents UsageEvent[]
}

// ─────────────────────────────────────────────────────────────
// Projects (Run 37) — chats that live in folders, and folders
// that carry their own mind. Each project has a NAME and a set
// of INSTRUCTIONS that the gateway injects into every turn of
// every chat that belongs to it (appended to the base system
// prompt AFTER memory — and therefore into the response-cache
// key, exactly like memory: editing a project's instructions
// naturally invalidates its stale cached answers; a project with
// NO instructions changes nothing, byte-identical prompts).
// Deleting a project keeps its chats (SetNull) — they simply
// fall back to "Recent"; no cascade, ever.
// ─────────────────────────────────────────────────────────────
model Project {
  id           String   @id @default(cuid())
  name         String
  instructions String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chats Chat[]
}

// ─────────────────────────────────────────────────────────────
// Chats — temporary chats are kept out of the "Recent" history.
// ─────────────────────────────────────────────────────────────
model Chat {
  id          String   @id @default(cuid())
  title       String   @default("New chat")
  model       String   @default("free/glm-5.3")
  provider    String   @default("APInex")
  isTemporary Boolean  @default(false)
  // Run 37 — the project this chat belongs to (null = "Recent").
  // Server truth: the gateway re-derives the project block from
  // the CHAT's own row on every turn, never from client claims.
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages Message[]
  rituals  Ritual[]
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  model     String? // model used for assistant replies
  provider  String? // provider that served the reply
  keyLabel  String? // pooled key that served the reply (for timeline debug)
  tokens    Int      @default(0) // tokens billed for this message (0 when cached)
  // True when `tokens` is a chars/4 ESTIMATE because the upstream
  // provider did not report usage (Run 17) — the timeline shows
  // "≈ N tokens (estimated)" so an estimate is never presented as
  // exact usage.
  tokensEstimated Boolean @default(false)
  cached    Boolean  @default(false) // served from exact-match cache
  sources   String? // JSON array [{title,url,snippet}] when web search ran
  // Effort dial: "fast" | "medium" | "deep" on assistant replies
  // (null = pre-dial messages, treated as medium).
  effort    String?
  // Attachments the gateway ACTUALLY read on user messages — JSON
  // array of AttachmentRecord (name, kind, method, chars, extract…).
  // Only successfully-extracted files land here; the model never
  // receives a file it wasn't given the content of.
  attachments String?
  // Duel turns: the winning lane is the message itself; the losing
  // lane is kept as a viewable runner-up reference.
  altContent String? // runner-up answer text (duel turns only)
  altModel   String? // runner-up model id
  // Regenerate: previous answers of this turn — JSON array of
  // {content, model, tokens, cached, servedBy, keyLabel, effort}.
  // The ACTIVE answer always lives in content/model; `variants`
  // holds the earlier ones so the user can flip back through them.
  variants     String? // JSON AnswerVariant[] (regenerate history)
  variantIndex Int?    // index of the active answer inside `variants`
  // Run 22 — Image Forge: JSON ImageRef of the ACTIVE generated image
  // (id on disk, dimensions, bytes, ms, prompt). `content` carries a
  // text marker for search/export/model history; the timeline renders
  // the image card whenever this is set. Re-rolls snapshot earlier
  // images inside `variants` entries (image field there too).
  image        String? // JSON ImageRef
  // Run 34 — Rituals: set on user messages a scheduled ritual
  // fired (the scheduler stamps it right after the turn persists
  // the row). The timeline renders a "Ritual · <title>" badge and
  // the store resolves the title from the ritual list.
  ritualId     String?
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Rituals (Run 34) — scheduled prompts that fire server-side on
// their own clock, whether or not the app is open. Each ritual
// owns ONE dedicated chat: every run appends the ritual prompt
// (user turn, stamped with ritualId) and the gateway's grounded
// answer there, so briefs accumulate in one readable thread —
// and the user can reply inside it, giving later runs context.
//   kind        "daily" (hour:minute) | "weekly" (weekday+time) |
//               "interval" (every intervalMin minutes)
//   nextRunAt   UTC instant of the next due fire — the scheduler
//               loop advances it AFTER each run (at-least-once:
//   lastStatus  "ok · N tokens" | "error: …" — honest receipt
// Schedule times are evaluated in the owner's timezone
// (Africa/Algiers); storage is UTC instants only.
// ─────────────────────────────────────────────────────────────
model Ritual {
  id          String   @id @default(cuid())
  title       String
  prompt      String
  chatId      String   @unique
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  kind        String // "daily" | "weekly" | "interval"
  hour        Int      @default(8) // daily/weekly — local hour (0-23)
  minute      Int      @default(0) // daily/weekly — local minute (0-59)
  weekday     Int      @default(1) // weekly — 0=Sun .. 6=Sat
  intervalMin Int      @default(1440) // interval — every N minutes
  search      Boolean  @default(true) // grounded with web search
  isActive    Boolean  @default(true)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  lastStatus  String?
  runCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Usage events — every completion is logged here. The 3-tier
// pacing limiter (monthly pool / daily pace / 5h burst) reads
// these events with time-window aggregation.
// ─────────────────────────────────────────────────────────────
model UsageEvent {
  id               String   @id @default(cuid())
  keyId            String?
  key              ApiKey?  @relation(fields: [keyId], references: [id], onDelete: SetNull)
  providerId       String
  provider         Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  chatId           String?
  model            String   @default("")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0) // raw tokens (before multiplier)
  multiplier       Float    @default(1.0)
  cached           Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([keyId, createdAt])
  @@index([providerId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Response cache — exact-match (sha256(prompt|model|system)),
// 24h TTL, cache hits are served with 0 tokens spent.
// ─────────────────────────────────────────────────────────────
model ResponseCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  model     String
  provider  String
  content   String
  tokens    Int      @default(0) // tokens the original call spent
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Memory (Run 28) — durable facts and preferences the user asked
// Hermes to remember. Injected into every system prompt (and
// therefore into the response-cache key: editing memory naturally
// invalidates stale cached answers). Ordered by creation.
// ─────────────────────────────────────────────────────────────
model Memory {
  id        String   @id @default(cuid())
  content   String // one remembered fact / preference (≤ 500 chars)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
